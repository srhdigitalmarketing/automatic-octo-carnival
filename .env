# Public defaults only. Never commit real credentials.
CI_ENVIRONMENT = production

# Redis analytics: dedicated local instance.
analytics.enabled = true
analytics.host = 127.0.0.1
analytics.port = 6379
analytics.database = 0
analytics.prefix = 'player:analytics:'
analytics.timezone = 'Asia/Jakarta'

# Set the real password on the server if Redis requires authentication.
analytics.password = ''
# analytics.username = ''

# Database settings are intentionally NOT overridden.
# Keep the existing server database configuration.
# If your server requires database credentials in .env, add the real values
# there only; do not use example credentials and do not commit them.
